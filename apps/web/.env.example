# Explore & Earn — apps/web environment variables.
#
# This file documents the EMAIL (Resend) and ADMIN configuration. Other services
# (Clerk, Supabase anon/url, etc.) have their own configuration and are not all
# enumerated here.

# Transactional email (Resend) — see apps/web/lib/email.ts.
# Required to actually SEND product notification emails. When unset in
# development, emails are logged to the console instead of being sent, so local
# dev works without any Resend setup.
RESEND_API_KEY=your_resend_api_key_here

# Optional: From header for transactional emails. Defaults to
# "Explore & Earn <notifications@exploreandearn.com>". Set this to a verified
# Resend sending domain (e.g. "Explore & Earn <noreply@automatedempires.com>")
# until exploreandearn.com is configured in Resend.
RESEND_FROM_EMAIL=

# Optional: absolute base URL used to build links inside emails.
# Defaults to https://exploreandearn.com.
NEXT_PUBLIC_APP_URL=https://exploreandearn.com

# Dev Mock Bench (review tooling only — apps/web/lib/devBench). The bench is
# AUTO-ON under `next dev` (NODE_ENV !== "production") and structurally OFF in
# any deployed build (production and Vercel preview both build with
# NODE_ENV=production). You do NOT need to set anything to use it. The only
# accepted value is "0", which force-disables the bench locally so you can test
# real Clerk auth. NEVER commit this set to anything other than 0 — the
# check-dev-bench guardrail (G040) fails the build if you do.
# NEXT_PUBLIC_DEV_BENCH=0

# Stripe secret key — SERVER-ONLY SECRET. Required for Stripe-hosted checkout,
# customer portal sessions, and webhook verification. Keep this in Vercel's
# server-side environment only; never prefix it with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for https://<domain>/api/webhooks/stripe.
# Use the endpoint secret from the Stripe Dashboard or Stripe CLI.
STRIPE_WEBHOOK_SECRET=

# Host subscription Stripe price ids. These must map directly to the founder-
# locked plan contracts in packages/contracts/src/pricing.ts.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# Paid community announcement Stripe price ids (one-off durations), consumed by
# apps/web/services/stripe/index.ts. A missing id makes the matching purchase
# fail loudly rather than silently. Mirrors the root .env.example.
STRIPE_PRICE_ANNOUNCEMENT_7D=
STRIPE_PRICE_ANNOUNCEMENT_14D=
STRIPE_PRICE_ANNOUNCEMENT_28D=

# OPTIONAL: paid listing-boost Stripe price ids (one-off durations), consumed by
# apps/web/services/stripe/index.ts. Unlike the vars above, these are optional —
# when unset the boost checkout falls back to inline price_data from the
# BOOST_PRICING contract, so boosts still work. Set them to use catalog prices.
STRIPE_PRICE_BOOST_7D=
STRIPE_PRICE_BOOST_14D=
STRIPE_PRICE_BOOST_28D=

# ---------------------------------------------------------------------------
# Admin panel (founder operations center) — the (admin) route group.
# ---------------------------------------------------------------------------

# Clerk user id (user_xxx) of the single founder/admin allowed into /admin.
# The admin panel is gated by an explicit user-id allow-list (NOT a Clerk role),
# so a leaked role can never escalate into admin. Leave UNSET to lock everyone
# out of /admin (the allow-list becomes empty). Find your id in the Clerk
# dashboard or via auth().userId.
ADMIN_CLERK_USER_ID=

# Supabase SERVICE ROLE key — SERVER-ONLY SECRET. Used by the admin panel's
# service-role client (packages/db/src/adminClient.ts) to read and moderate
# every row, bypassing Row Level Security. NEVER expose this to the browser and
# NEVER prefix it with NEXT_PUBLIC_. Found in the Supabase dashboard under
# Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI assistant (seeker guide) ─────────────────────────────────────────────
# Vercel AI Gateway key — routes the assistant's model calls (server-only).
# UNSET → the /assistant page shows a graceful "not available" state and the
# /api/assistant endpoint returns 503, so nothing crashes without AI configured.
# In production Vercel supplies this via OIDC; set it explicitly elsewhere.
AI_GATEWAY_API_KEY=
# Model the assistant uses, as a Gateway "provider/model" string. Override to
# change the model without a code change. Fetch current ids from the gateway
# (GET https://ai-gateway.vercel.sh/v1/models); prefer the newest Sonnet.
ASSISTANT_MODEL=anthropic/claude-sonnet-4.5
