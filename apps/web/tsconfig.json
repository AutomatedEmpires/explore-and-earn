{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "jsx": "preserve",
    "noEmit": true
  },
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/ui" }
  ],
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "i18n/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "next-env.d.ts",
    "services/**/*.ts",
    "services/**/*.tsx",
    "styles/**/*.css",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
