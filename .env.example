# Explore & Earn — environment variable manifest (NAMES ONLY, NO VALUES)
#
# Source of truth for VALUES is Doppler (locked secrets manager, 2026-06-01).
# Pull locally with the Doppler CLI; never paste real secrets here or commit a real .env.
#   doppler setup            # link this repo to the E&E project/config
#   doppler run -- pnpm dev  # run with injected secrets
#   doppler secrets download --no-file --format env > ~/.config/explore-and-earn/.env.local
#
# .env* is git-ignored and editor-read-only. This .env.example is the ONLY env file in the repo.
#
# CROSS-APP PROVIDER LOCK (2026-06-04): Auth = Clerk, Maps = Mapbox across all three apps
# (E&E / BidSpace / Sweepza). E&E is migrating OFF Supabase Auth + Azure Maps — see issue #91.

# --- Doppler ---
DOPPLER_TOKEN=

# --- Supabase (database / storage ONLY — auth moved to Clerk, see #91) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF_STAGING=
SUPABASE_PROJECT_REF_PROD=
DATABASE_URL=

# --- Clerk (AUTH — cross-app standard, locked 2026-06-04; replaces Supabase Auth, see #91) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# --- Stripe (payments, test mode until go-live) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs read by services/stripe (requireEnv throws at checkout if any are
# unset). Host subscription plans (monthly + yearly) and boosted-announcement
# durations. Create the prices in the Stripe dashboard and set these per-env.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
STRIPE_PRICE_ANNOUNCEMENT=
# Optional listing-boost price ids — fall back to inline price_data when unset.
STRIPE_PRICE_BOOST_7D=
STRIPE_PRICE_BOOST_14D=
STRIPE_PRICE_BOOST_28D=

# --- Vercel (hosting) ---
VERCEL_TOKEN=
# Public canonical app URL — used by metadataBase, robots.ts sitemap, and OG tags.
# Non-secret; safe to commit. Set per-environment in Vercel (preview vs production).
NEXT_PUBLIC_APP_URL=

# --- Cloudinary (public image delivery) ---
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- PostHog (product analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=

# --- Sentry (error monitoring) ---
# SENTRY_DSN is read server-side only (instrumentation.ts).
# NEXT_PUBLIC_SENTRY_DSN must be set separately so the client bundle can read it
# (instrumentation-client.ts). Both should be set to the same DSN value.
# SENTRY_ORG and SENTRY_PROJECT are used by @sentry/nextjs during the Vercel build
# to upload source maps. Find them in Sentry: Settings → Projects.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Optional override for the From address (defaults to
# "Explore & Earn <notifications@exploreandearn.com>").
RESEND_FROM_EMAIL=

# --- Cron (scheduled jobs) ---
# Bearer token required by GET /api/cron/expire-listings. Set in Vercel + the
# cron scheduler's Authorization header so only the scheduler can trigger it.
CRON_SECRET=

# --- Mapbox (MAPS — cross-app standard, locked 2026-06-04; replaces Azure Maps, see #91) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# --- GitHub (agent + CI automation) ---
GITHUB_TOKEN=

# --- PR agent dispatch webhooks (used by .github/workflows/pr-agent-dispatch.yml; set in CI secrets, not local) ---
CODEX_AGENT_WEBHOOK_URL=
CODEX_AGENT_WEBHOOK_TOKEN=
CLAUDE_AGENT_WEBHOOK_URL=
CLAUDE_AGENT_WEBHOOK_TOKEN=
SENTRY_AGENT_WEBHOOK_URL=
SENTRY_AGENT_WEBHOOK_TOKEN=
GIT_AGENT_WEBHOOK_URL=
GIT_AGENT_WEBHOOK_TOKEN=

# --- AI model keys (optional workers) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
