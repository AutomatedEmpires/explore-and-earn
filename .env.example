# Explore & Earn — environment variable manifest (NAMES ONLY, NO VALUES)
#
# Source of truth for VALUES is Doppler (locked secrets manager, 2026-06-01).
# Pull locally with the Doppler CLI; never paste real secrets here or commit a real .env.
#   doppler setup            # link this repo to the E&E project/config
#   doppler run -- pnpm dev  # run with injected secrets
#   doppler secrets download --no-file --format env > ~/.config/explore-and-earn/.env.local
#
# .env* is git-ignored and editor-read-only. This .env.example is the ONLY env file in the repo.

# --- Doppler ---
DOPPLER_TOKEN=

# --- Supabase (database / auth / storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF_STAGING=
SUPABASE_PROJECT_REF_PROD=
DATABASE_URL=

# --- Stripe (payments, test mode until go-live) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Vercel (hosting) ---
VERCEL_TOKEN=

# --- Cloudinary (public image delivery) ---
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- PostHog (product analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=
POSTHOG_PERSONAL_API_KEY=

# --- Sentry (error monitoring) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Azure Maps (geo / discovery) ---
AZURE_MAPS_KEY=

# --- GitHub (agent + CI automation) ---
GITHUB_TOKEN=

# --- CLAOS cloud-agent dispatch (set in CI / Doppler, not local) ---
COPILOT_CLOUD_TOKEN=

# --- AI model keys (optional workers) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
