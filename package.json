{
  "name": "explore-and-earn",
  "version": "0.1.0",
  "private": true,
  "description": "Explore&Earn Sprint Zero monorepo scaffold",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "corepack pnpm --filter @explore-and-earn/web dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm --filter @explore-and-earn/web test:e2e",
    "db:assert": "corepack pnpm --filter @explore-and-earn/db-assert check",
    "guardrails": "corepack pnpm db:assert && node tools/scripts/check-pricing.mjs && node tools/scripts/check-calendar-sync.mjs && node tools/scripts/check-match-isolation.mjs && node tools/scripts/check-pricing-units.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "playwright": "^1.60.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
