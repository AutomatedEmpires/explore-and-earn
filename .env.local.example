# Explore&Earn local environment.
# Copy to .env.local (gitignored) and adjust. Every key the app reads is listed here.
# Dev defaults use stub or local providers, which are refused when APP_ENV=prod.

# --- App ---
APP_ENV=dev
APP_URL=http://localhost:3000
ADMIN_HOST=admin.localhost:3000
# `pnpm db:local` serves PGlite with PostGIS on this port.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# --- Clerk ---
# Leave empty in dev to run Clerk in keyless mode. Required in preview and prod.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# --- Storage: supabase | local | stub ---
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_STORAGE_DIR=.data/storage

# --- AI: anthropic | stub ---
AI_PROVIDER=stub
ANTHROPIC_API_KEY=

# --- Child safety: photodna | stub ---
CHILD_SAFETY_PROVIDER=stub
PHOTODNA_KEY=
# Comma-separated sha256 hashes the stub scanner treats as a match.
CHILD_SAFETY_STUB_HASHES=

# --- Malware: cloudmersive | stub ---
MALWARE_PROVIDER=stub
CLOUDMERSIVE_API_KEY=

# --- Email: resend | stub ---
EMAIL_PROVIDER=stub
RESEND_API_KEY=
EMAIL_FROM=Explore&Earn <noreply@localhost>

# --- Web push (generate real keys with the VAPID script) ---
VAPID_PUBLIC_KEY=dev-placeholder-vapid-public-key
VAPID_PRIVATE_KEY=dev-placeholder-vapid-private-key
VAPID_SUBJECT=mailto:dev@localhost

# --- Secrets (at least 32 characters; use random values outside dev) ---
JOBS_SECRET=dev-only-jobs-secret-0000000000000000
UNSUBSCRIBE_SECRET=dev-only-unsubscribe-secret-00000000
# HMAC key for listing view dedupe and the guest viewer key (SP3).
ANALYTICS_HASH_SECRET=dev-only-analytics-hash-secret-0000000

# --- Monitoring (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Billing: stripe | stub ---
# stub runs Checkout in auto-complete mode (no Stripe calls). With stripe, use sk_test_ keys
# outside prod; the portal configuration ids are printed by `pnpm stripe:seed`.
BILLING_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_FULL=
STRIPE_PORTAL_CONFIG_BILLING=

# --- Geocoder: census | stub ---
GEOCODER_PROVIDER=stub

# --- Weather: nws | stub ---
WEATHER_PROVIDER=stub
# The National Weather Service requires a contact in the User-Agent.
NWS_USER_AGENT=Explore&Earn (support@exploreandearn.com)

# --- Link safety: webrisk | stub ---
LINK_SAFETY_PROVIDER=stub
WEB_RISK_API_KEY=

# --- Maps (a public pk. token; required in preview and prod) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
